# Build outputs: everything below is rebuilt from the sources (docs/10-tooling.md).
# Kept in the repository on purpose: attiny/loader_data.inc, the default ATtiny
# image's data (generated by `gbcpop attiny-inc`), so a checkout can be flashed
# right away.

# rgbds intermediates and ROM images (incl. the payloads' standalone and test ROMs)
*.o
*.map
*.sym
*.gb
*.gbc

# Game Boy binaries built from the sources. Only the ones our Makefiles build:
# a payload may also be a prebuilt <name>.bin that belongs in the repo (docs/07).
/gb/*.bin
/payloads/snake/snake.bin
/payloads/save-patcher/save-patcher.bin
/payloads/card-pop/card-pop.bin
# audio dumper: built and copied from the upstream checkout by build.sh (MIT,
# deliberately not redistributed here)
/payloads/audio-dumper/*.bin

# host tool (gbcpop) and its optional resident bridge image
/host/gbcpop
/host/gbcpop-offline
/host/payload.bin

# ATtiny build, EEPROM dumps and the simavr harness
/attiny/*.hex
/attiny/loader_data_debug.inc
/attiny/*.obj
/attiny/*.cof
/attiny/eeprom.bin
/attiny/ee*.bin
/attiny/sim/pb0_trace

# save files: keep personal saves out of the repository
*.sav
*.ram

# Python
__pycache__/
venv/
